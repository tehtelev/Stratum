+        /// <summary>
+        /// Clamp the structure's Y coordinates to ensure it fits within the world's valid height range
+        /// </summary>
+        private void ClampStructureY(ref Cuboidi strucloc, ref BlockPos startPos, int sizeY, int maxY)
+        {
+            // Maximum and minimum VALID block coordinates in the world
+            int maxValidY = maxY - 1;
+            int minValidY = 1; // Above bedrock (mantle at Y=0)
+
+            // Calculate the actual block coordinates of the structure
+            int blockMinY = strucloc.Y1;
+            int blockMaxY = strucloc.Y1 + sizeY - 1; // Last block coordinate
+
+            // 1. Protection against spawning below bedrock
+            if (blockMinY < minValidY)
+            {
+                blockMinY = minValidY;
+            }
+
+            // 2. If the structure is physically taller than the world
+            if (sizeY > maxY)
+            {
+                // Hard-clamp the structure to the world height
+                blockMinY = minValidY;
+                blockMaxY = maxValidY;
+            }
+            // 3. If the top boundary exceeds the world, shift the structure down
+            else if (blockMaxY > maxValidY)
+            {
+                int excess = blockMaxY - maxValidY;
+                blockMinY -= excess;
+                blockMaxY = maxValidY;
+            }
+
+            // Update strucloc
+            // In your code Y2 = Y1 + SizeY (exclusive upper bound)
+            strucloc.Y1 = blockMinY;
+
+            // If the structure was clipped (sizeY > maxY), Y2 should be maxY
+            if (sizeY > maxY)
+            {
+                strucloc.Y2 = maxY;
+            }
+            else
+            {
+                strucloc.Y2 = blockMinY + sizeY;
+            }
+
+            // Synchronize startPos with the final lower bound
+            startPos.Y = strucloc.Y1;
+        }
